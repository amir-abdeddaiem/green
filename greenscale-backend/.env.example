# Verdustry Backend - Environment Variables Example
# Copy this file to .env and update with your actual values

# ==================== DATABASE ====================
# Neon PostgreSQL connection string
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_E2DLCUn1gwyH@ep-fragrant-dew-am3swx4g-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_ECHO=false

# ==================== API CONFIGURATION ====================
# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (disable in production)
DEBUG=true

# ==================== CORS CONFIGURATION ====================
# Allowed origins for frontend (comma-separated)
# Frontend URLs that can call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==================== AUTHENTICATION ====================
# Secret key for JWT token signing (change in production!)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-12345

# JWT algorithm
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== GOOGLE SERVICES ====================
# Google API Key (for various services)
GOOGLE_API_KEY=your-google-api-key-here

# Google Chat Space ID (for chat integration)
GOOGLE_CHAT_SPACE_ID=spaces/AAAAC3lJWXo

# Gemini API Key (for AI responses)
GEMINI_API_KEY=your-gemini-api-key-here

# ==================== UPLOAD CONFIGURATION ====================
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Directory for uploads
UPLOAD_DIR=uploads

# ==================== LOGGING ====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
