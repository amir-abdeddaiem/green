# Verdustry Backend - Environment Variables Example
# Copy this file to .env and update with your actual values

# ==================== DATABASE ====================
# Neon PostgreSQL connection string
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_E2DLCUn1gwyH@ep-fragrant-dew-am3swx4g-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&hostaddr=54.209.204.248&connect_timeout=30

DATABASE_ECHO=false

# ==================== API CONFIGURATION ====================
# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (disable in production)
DEBUG=true

# ==================== CORS CONFIGURATION ====================
# Prototype/debug switch to allow requests from ANY origin.
# WARNING: do not use in real production.
# When true, the backend will set CORS to allow all origins.
CORS_ALLOW_ALL=false

# Allowed origins for frontend (comma-separated)
# Frontend URLs that can call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://verdustry.vercel.app

# ==================== AUTHENTICATION ====================
# Secret key for JWT token signing (change in production!)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=KtoQGCocjFGrsy8_5ROeF1cxgg1EtzwxoUT39hRpiKM

# JWT algorithm
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== GOOGLE SERVICES ====================
# Google API Key (for various services)
GOOGLE_API_KEY=

# Google Chat Space ID (for chat integration)
GOOGLE_CHAT_SPACE_ID=spaces/AAAAC3lJWXo

# Gemini API Key (for AI responses)
GEMINI_API_KEY=

# Enable Gemini-based extraction fallback (post-OCR). Default: false
GEMINI_EXTRACTION_ENABLED=false

# Gemini model name (Google GenAI). Example: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# ==================== UPLOAD CONFIGURATION ====================
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Directory for uploads
UPLOAD_DIR=uploads

# ==================== OCR (TESSERACT) ====================
# Install Tesseract OCR on the host OS, then either add it to PATH or set the full path below.
# Windows default path example:
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=

# OCR languages. Arabic needs ara.traineddata installed.
TESSERACT_LANGUAGES=eng+fra+ara

# For PDFs, the backend renders the first N pages and OCRs them.
OCR_PDF_MAX_PAGES=2

# ==================== OCR (PaddleOCR) ====================
# Choose OCR engine: tesseract (default, requires Tesseract binary) or paddle (optional).
# NOTE: PaddleOCR is a heavy optional dependency and may not be available for every Python version/platform.
# If you set OCR_ENGINE=paddle, ensure you also installed the PaddleOCR requirements.
OCR_ENGINE=tesseract

# PaddleOCR languages (space-separated): 'fr' and/or 'ar'
PADDLE_OCR_LANGS=fr ar

# Limit PDF pages for OCR
PADDLE_PDF_MAX_PAGES=2

# ==================== OLLAMA (Local LLM Extraction) ====================
# Enable post-OCR extraction via Ollama (returns JSON rows)
OLLAMA_EXTRACTION_ENABLED=true

# Ollama base URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model tag
OLLAMA_MODEL=qwen2.5:7b-instruct

# ==================== LOGGING ====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
